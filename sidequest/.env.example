# ==========================================
# UCU SideQuest — Environment Configuration
# ==========================================

# Backend & Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sidequest
# For local testing without Postgres, SQLite is also supported:
# DATABASE_URL=sqlite+aiosqlite:///./sidequest.db

# Authentication (Must be >= 32 characters in production)
SECRET_KEY=ucu-sidequest-dev-insecure-secret-key-change-in-prod-2026-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Timezone
APP_TIMEZONE=Europe/Kyiv

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# AWS Production Target Configurations (Reference only for production deployment)
# AWS_REGION=eu-central-1
# COGNITO_USER_POOL_ID=eu-central-1_example
# COGNITO_CLIENT_ID=exampleclientid123456
# AURORA_DATABASE_URL=postgresql+asyncpg://...
