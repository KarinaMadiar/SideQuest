# ==============================================================================
# UCU SideQuest — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to `.env` (and `frontend/.env.local` if running without Docker).
# Never commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend & Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sidequest
# For local development without PostgreSQL/Docker, SQLite is supported out of the box:
# DATABASE_URL=sqlite+aiosqlite:///./sidequest.db

# Local JWT Secret Key (Must be >= 32 characters in production; secret, backend-only)
SECRET_KEY=ucu-sidequest-dev-insecure-secret-key-change-in-prod-2026-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application Timezone & CORS
APP_TIMEZONE=Europe/Kyiv
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=https://.*\.amplifyapp\.com

# ------------------------------------------------------------------------------
# 2. Amazon Cognito & Google Federation (Backend Validation)
# ------------------------------------------------------------------------------
# Leave empty or false for offline local development with email/password accounts.
# Populate from CloudFormation stack outputs (`infrastructure/cognito-google-auth.yaml`)
# when enabling Google sign-in through Amazon Cognito.
AWS_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
GOOGLE_SIGNIN_ENABLED=false

# Note: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are configured exclusively in
# AWS Cognito (via CloudFormation parameters or AWS Secrets Manager / SSM) and
# must NEVER be placed in frontend NEXT_PUBLIC_* variables or committed to git.

# ------------------------------------------------------------------------------
# 3. Frontend Public Configuration (Browser-accessible NEXT_PUBLIC_* variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# Public Cognito Hosted UI OAuth 2.0 + PKCE configuration (no secrets!)
NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED=false
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000/login
NEXT_PUBLIC_COGNITO_SCOPES="openid email profile"
